<Window x:Class="Jednoreki_Bandyta.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Jednoreki_Bandyta"
        mc:Ignorable="d"
        Title="Jednoręki Bandyta" Height="450" Width="800">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Resources/backgrounds/table_green.png"/>
        </Grid.Background>
        <Canvas>
            <Image Source="/Resources/slots/slots_bg.png"
                   Canvas.Left="195" Height="375" Width="409" HorizontalAlignment="Left" VerticalAlignment="Center" Canvas.Top="-10"/>
            <Image Source="/Resources/slots/1.png"
                   x:Name="slot1"
                   Canvas.Left="234" Height="108" Width="100" HorizontalAlignment="Left" VerticalAlignment="Center" Canvas.Top="112" RenderTransformOrigin="0.455,1.042"/>
            <Image Source="/Resources/slots/1.png"
                   x:Name="slot2"
        Canvas.Left="464" Height="108" Width="100" HorizontalAlignment="Left" VerticalAlignment="Center" Canvas.Top="112" RenderTransformOrigin="0.455,1.042"/>
            <Image Source="/Resources/slots/1.png"
                   x:Name="slot3"
        Canvas.Left="350" Height="108" Width="100" HorizontalAlignment="Center" VerticalAlignment="Top" Canvas.Top="116" RenderTransformOrigin="0.455,1.042"/>

            <Image Source="/Resources/slots/slot_machine.png"
        Canvas.Left="110" Height="444" Width="628" HorizontalAlignment="Left" VerticalAlignment="Top" Canvas.Top="-10"/>
            <Slider x:Name="animationDuration"
            Minimum="5"
            Maximum="200"
            Value="20"
            TickFrequency="10"
            IsSnapToTickEnabled="True" HorizontalAlignment="Center" Height="20" Canvas.Top="114" VerticalAlignment="Top" Width="171" Canvas.Left="10"/>
            <Label Content="Animation duration:" Foreground="White" HorizontalAlignment="Center" Canvas.Left="10" Canvas.Top="88" VerticalAlignment="Top"/>
            <Button Content="Spin" Width="139" Click="Spin" Height="36" HorizontalAlignment="Center" Canvas.Left="23" Canvas.Top="148" VerticalAlignment="Top"/>

            <Label Content="Multiplayer:" Foreground="White" HorizontalAlignment="Center" Canvas.Left="10" Canvas.Top="59" VerticalAlignment="Top" Height="26"/>
            <TextBox x:Name="multiplayer" Text="1" HorizontalAlignment="Center" Canvas.Left="92" Canvas.Top="65" VerticalAlignment="Top" Width="32"/>
            <Image Source="/Resources/backgrounds/tlo_kasy.png" Stretch="Fill" Height="54" Width="153"/>
            <Label x:Name="balance" Content="1000$" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="24" Foreground="#1CA300" Height="42" Width="143" Canvas.Left="10" Canvas.Top="6"/>
        </Canvas>





    </Grid>
</Window>
